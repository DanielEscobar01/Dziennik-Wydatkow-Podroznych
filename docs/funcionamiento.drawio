        <mxCell id="sTitle" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#20344D;" value="ARRANQUE — de la sesión a las pantallas" vertex="1">
          <mxGeometry height="40" width="1000" x="48" y="30" as="geometry" />
        </mxCell>
        <mxCell id="sStart" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF8F1;strokeColor=#4A9366;strokeWidth=2;fontSize=15;fontColor=#20344D;spacing=10;" value="&lt;b&gt;Se carga src/main.js&lt;/b&gt;&lt;br&gt;Registra eventos y ejecuta initializeAuth()" vertex="1">
          <mxGeometry height="120" width="560" x="570" y="120" as="geometry" />
        </mxCell>
        <mxCell id="sInit" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF8F1;strokeColor=#4A9366;strokeWidth=2;fontSize=14;fontColor=#20344D;spacing=10;" value="&lt;b&gt;initializeAuth()&lt;/b&gt;&lt;br&gt;supabase.auth.getSession() lee la sesión guardada&lt;br&gt;Si llegó un evento Auth mientras esperaba, usa la sesión más reciente" vertex="1">
          <mxGeometry height="125" width="560" x="570" y="300" as="geometry" />
        </mxCell>
        <mxCell id="sSession" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A7FAD;strokeWidth=2;fontSize=14;fontColor=#20344D;spacing=10;" value="&lt;b&gt;renderAuthState()&lt;/b&gt;&lt;br&gt;Con sesión: muestra la aplicación privada&lt;br&gt;Sin sesión: muestra el formulario de acceso" vertex="1">
          <mxGeometry height="120" width="560" x="570" y="485" as="geometry" />
        </mxCell>
        <mxCell id="sNoSession" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E8;strokeColor=#C17A31;strokeWidth=2;fontSize=13;fontColor=#20344D;spacing=10;" value="&lt;b&gt;Sin sesión&lt;/b&gt;&lt;br&gt;No consulta viajes ni gastos privados.&lt;br&gt;render() deja visible el acceso." vertex="1">
          <mxGeometry height="125" width="400" x="70" y="490" as="geometry" />
        </mxCell>
        <mxCell id="sListener" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E8;strokeColor=#C17A31;strokeWidth=2;fontSize=12;fontColor=#20344D;spacing=10;" value="&lt;b&gt;onAuthStateChange()&lt;/b&gt;&lt;br&gt;Antes de initializeAuth: guarda el evento pendiente.&lt;br&gt;Después: actualiza currentUser; al salir limpia datos; al entrar llama loadTrips()." vertex="1">
          <mxGeometry height="150" width="420" x="70" y="150" as="geometry" />
        </mxCell>
        <mxCell id="sTrips" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF8F1;strokeColor=#4A9366;strokeWidth=2;fontSize=13;fontColor=#20344D;spacing=10;" value="&lt;b&gt;loadTrips()&lt;/b&gt;&lt;br&gt;Consulta trips + trip_days; convierte columnas a objetos del viaje.&lt;br&gt;Si falla, informa el error; no inventa viajes." vertex="1">
          <mxGeometry height="140" width="560" x="570" y="660" as="geometry" />
        </mxCell>
        <mxCell id="sReservations" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF8F1;strokeColor=#4A9366;strokeWidth=2;fontSize=13;fontColor=#20344D;spacing=10;" value="&lt;b&gt;loadTripReservations(ownerId)&lt;/b&gt;&lt;br&gt;Lee trip_reservations y agrupa por viaje.&lt;br&gt;Si no está disponible, puede usar la vista previa de sessionStorage." vertex="1">
          <mxGeometry height="140" width="560" x="570" y="850" as="geometry" />
        </mxCell>
        <mxCell id="sHistory" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF8F1;strokeColor=#4A9366;strokeWidth=2;fontSize=13;fontColor=#20344D;spacing=10;" value="&lt;b&gt;loadPersonalTravelHistory(ownerId)&lt;/b&gt;&lt;br&gt;Vuelos · estancias · análisis de Polonia · ubicaciones diarias.&lt;br&gt;Usa vista previa en localhost o tablas personales; ubicaciones se leen por lotes de 1000.&lt;br&gt;RLS restringe la historia al propietario." vertex="1">
          <mxGeometry height="160" width="560" x="570" y="1040" as="geometry" />
        </mxCell>
        <mxCell id="sSelect" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A7FAD;strokeWidth=2;fontSize=13;fontColor=#20344D;spacing=10;" value="&lt;b&gt;Elige currentTrip y selectedDate&lt;/b&gt;&lt;br&gt;Conserva el viaje anterior si existe; si no, toma el primero.&lt;br&gt;initialSelectedDate(): hoy dentro del viaje o el primer día." vertex="1">
          <mxGeometry height="120" width="560" x="570" y="1250" as="geometry" />
        </mxCell>
        <mxCell id="sExpenses" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF8F1;strokeColor=#4A9366;strokeWidth=2;fontSize=13;fontColor=#20344D;spacing=10;" value="&lt;b&gt;loadExpenses()&lt;/b&gt;&lt;br&gt;Lee expenses del viaje activo y mapea las columnas SQL.&lt;br&gt;Descarta resultados tardíos si cambió cuenta o viaje." vertex="1">
          <mxGeometry height="130" width="560" x="570" y="1420" as="geometry" />
        </mxCell>
        <mxCell id="sRender" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A7FAD;strokeWidth=2;fontSize=14;fontColor=#20344D;spacing=10;" value="&lt;b&gt;render()&lt;/b&gt;&lt;br&gt;Actualiza la interfaz a partir del estado en memoria; no vuelve a pedir los datos." vertex="1">
          <mxGeometry height="110" width="560" x="570" y="1600" as="geometry" />
        </mxCell>
        <mxCell id="sOutputs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EFFA;strokeColor=#8969AD;strokeWidth=2;fontSize=12;fontColor=#20344D;spacing=8;" value="renderTripContext · renderTripSelector · renderSummary · renderCharts&lt;br&gt;renderDays · renderExpenses · renderReservations · renderDayPage (si está abierta)&lt;br&gt;renderPersonalHistory (solo cuando su página está visible)" vertex="1">
          <mxGeometry height="90" width="1020" x="340" y="1740" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
