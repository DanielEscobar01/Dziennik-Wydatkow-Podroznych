        <mxCell id="ePreview" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A7FAD;strokeWidth=2;fontSize=13;fontColor=#20344D;spacing=8;" value="&lt;b&gt;updatePreview()&lt;/b&gt;&lt;br&gt;Importe local × tasa = vista previa PLN; todavía no guarda" vertex="1">
