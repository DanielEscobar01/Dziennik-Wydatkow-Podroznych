          <mxGeometry height="85" width="500" x="1000" y="465" as="geometry" />
        </mxCell>
        <mxCell id="eUpsert" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF8F1;strokeColor=#4A9366;strokeWidth=2;fontSize=12;fontColor=#20344D;spacing=8;" value="&lt;b&gt;Upsert con source_ref para evitar duplicados&lt;/b&gt;&lt;br&gt;trips → trip_days → trip_reservations → expenses" vertex="1">
