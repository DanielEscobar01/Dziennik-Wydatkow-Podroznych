        </mxCell>
        <mxCell id="eState" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF8F1;strokeColor=#4A9366;strokeWidth=2;fontSize=12;fontColor=#20344D;spacing=8;" value="&lt;b&gt;Actualiza estado y confirma&lt;/b&gt;&lt;br&gt;Mapea fila → expenses → selectedDate → render().&lt;br&gt;Cierra el diálogo y muestra showToast()." vertex="1">
          <mxGeometry height="135" width="620" x="172" y="1180" as="geometry" />
        </mxCell>
        <mxCell id="eActions" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E8;strokeColor=#C17A31;strokeWidth=2;fontSize=12;fontColor=#20344D;spacing=8;" value="&lt;b&gt;Acciones desde renderExpenses()&lt;/b&gt;&lt;br&gt;data-paid → markExpensePaid(): UPDATE de estado.&lt;br&gt;data-delete → deleteExpense(): DELETE; solo quita del estado tras confirmación.&lt;br&gt;data-edit → openEditExpenseDialog().&lt;br&gt;Errores se muestran; no se simula éxito." vertex="1">
          <mxGeometry height="245" width="782" x="92" y="1360" as="geometry" />
        </mxCell>
        <mxCell id="eImport" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5E8;strokeColor=#C17A31;strokeWidth=2;fontSize=12;fontColor=#20344D;spacing=8;" value="&lt;b&gt;importWorkbook(file)&lt;/b&gt;&lt;br&gt;Función escrita, pero no hay botón en la interfaz actual" vertex="1">
