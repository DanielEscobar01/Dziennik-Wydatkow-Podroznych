        </mxCell>
        <mxCell id="eSave" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A7FAD;strokeWidth=2;fontSize=12;fontColor=#20344D;spacing=8;" value="&lt;b&gt;saveExpense(event)&lt;/b&gt;&lt;br&gt;Valida sesión, viaje, descripción, moneda e importes positivos.&lt;br&gt;Redondea importe (2), tasa (8), PLN (2); evita doble envío.&lt;br&gt;Elige INSERT o UPDATE." vertex="1">
